import React, { useState } from 'react';
import { User, Lock, Gamepad2, Globe, Bot, Trophy, LogOut } from 'lucide-react';
import axios from 'axios';

const Auth = ({ onAuthSuccess }) => {
  const [isLogin, setIsLogin] = useState(true);
  const [username, setUsername] = useState('');
  const [password, setPassword] = useState('');
  const [error, setError] = useState('');
  const [isLoading, setIsLoading] = useState(false);

  const handleSubmit = async (e) => {
    e.preventDefault();
    setError('');
    setIsLoading(true);
    try {
      const endpoint = isLogin ? 'login' : 'register';
      const res = await axios.post(`http://localhost:5001/api/${endpoint}`, { username, password });
      localStorage.setItem('sup_token', res.data.token);
      localStorage.setItem('sup_user', JSON.stringify(res.data.user));
      onAuthSuccess(res.data.user);
    } catch (err) {
      setError(err.response?.data?.error || 'Could not connect to server. Please start your backend!');
    } finally {
      setIsLoading(false);
    }
  };

  return (
    <div className="flex flex-col items-center justify-center min-h-screen p-6 bg-yellow-100">
      <div className="mb-12 text-center">
        <div className="inline-block p-6 bg-white border-4 border-slate-900 rounded-full shadow-[8px_8px_0px_0px_rgba(15,23,42,1)] mb-6 animate-bounce">
          <Gamepad2 size={80} className="text-blue-500" />
        </div>
        <h1 className="text-8xl font-black uppercase italic text-slate-900 drop-shadow-2xl mb-2">
          sup
        </h1>
        <p className="text-xl font-bold text-slate-600 uppercase tracking-widest">The Ultimate Chess Arena</p>
      </div>

      <div className="cartoony-card w-full max-w-md relative p-8">
        <div className="absolute -top-6 -right-6 w-16 h-16 bg-yellow-400 border-4 border-slate-900 rounded-full flex items-center justify-center font-black text-2xl text-slate-900 rotate-12 shadow-[4px_4px_0px_0px_rgba(15,23,42,1)]">
          !
        </div>

        <h2 className="text-4xl font-black uppercase text-center mb-10 text-slate-900 italic">
          {isLogin ? 'Player Login' : 'Create Profile'}
        </h2>

        <form onSubmit={handleSubmit} className="flex flex-col gap-6">
          <div className="space-y-2">
            <label className="text-xs font-black uppercase ml-1 text-slate-500">Player Name</label>
            <div className="relative">
              <User className="absolute left-3 top-3 text-slate-400" size={20} />
              <input
                type="text"
                placeholder="e.g. ChessMaster99"
                className="cartoony-input w-full pl-10 py-4 text-lg font-bold"
                value={username}
                onChange={(e) => setUsername(e.target.value)}
                required
              />
            </div>
          </div>

          <div className="space-y-2">
            <label className="text-xs font-black uppercase ml-1 text-slate-500">Secret Password</label>
            <div className="relative">
              <Lock className="absolute left-3 top-3 text-slate-400" size={20} />
              <input
                type="password"
                placeholder="••••••••"
                className="cartoony-input w-full pl-10 py-4 text-lg font-bold"
                value={password}
                onChange={(e) => setPassword(e.target.value)}
                required
              />
            </div>
          </div>

          {error && (
            <div className="p-4 bg-red-100 border-4 border-red-500 text-red-600 text-sm font-black rounded-xl text-center uppercase animate-shake">
              {error}
            </div>
          )}

          <button
            type="submit"
            disabled={isLoading}
            className={`cartoony-button py-5 text-2xl transition-all ${isLoading ? 'bg-slate-400' : 'bg-blue-400 hover:bg-blue-300 active:scale-95'}`}
          >
            {isLoading ? 'Connecting...' : (isLogin ? 'Enter Arena' : 'Start Journey')}
          </button>
        </form>

        <div className="mt-10 text-center">
          <button
            onClick={() => setIsLogin(!isLogin)}
            className="text-slate-600 font-black uppercase text-sm hover:text-blue-600 transition-all underline decoration-4 underline-offset-4"
          >
            {isLogin ? "New player? Create an account" : "Already a member? Sign in"}
          </button>
        </div>
      </div>
    </div>
  );
};

export default Auth;
